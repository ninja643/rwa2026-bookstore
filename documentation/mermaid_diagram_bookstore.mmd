    BOOK ||--o{ BOOK_CATEGORY : linked
    CATEGORY ||--o{ BOOK_CATEGORY : linked

    ORDER ||--o{ ORDER_COUPON : linked
    COUPON ||--o{ ORDER_COUPON : linked

