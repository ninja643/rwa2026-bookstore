    BOOK ||--o{ CART_ITEM : added_to

    ORDER ||--o{ COUPON : uses

    BOOK ||--o{ BOOK_IMAGE : has
    BOOK ||--o{ INVENTORY_LOG : tracked_by

    USER }o--o{ ROLE : has
